# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older dashboard name; either this or PUBLISHABLE_KEY is enough
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Never expose this in client code or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Used for password-reset redirect links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional seed / Playwright
# SEED_TRAINER_EMAIL=trainer@trainertrack.local
# SEED_TRAINER_PASSWORD=ChangeMe123!
# E2E_EMAIL=trainer@trainertrack.local
# E2E_PASSWORD=ChangeMe123!
